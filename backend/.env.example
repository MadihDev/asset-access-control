# Tenant migration flags
# city-only | project-city
TENANT_MODE=city-only
# old | dual | new
TENANT_MIGRATION_READ_MODE=old
TENANT_MIGRATION_WRITE_MODE=old
# Backend environment variables

# Server
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/asset_access_control?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS
ALLOWED_ORIGIN=http://localhost:5173
WS_CORS_ORIGIN=http://localhost:5173

# Rate limiting (defaults apply if omitted)
RATE_LIMIT_WINDOW_MS=900000           # 15 minutes
RATE_LIMIT_MAX=300                    # 300 requests per window per IP

AUTH_RATE_LIMIT_WINDOW_MS=300000      # 5 minutes
AUTH_RATE_LIMIT_MAX=20                # 20 requests per window per IP (login endpoints)

# Bulk operations
MAX_LOCATION_BULK_ITEMS=500           # Max items allowed in one bulk request
BULK_RATE_LIMIT_WINDOW_MS=60000       # 1 minute
BULK_RATE_LIMIT_MAX=10                # Max bulk requests per window per IP

# Dev simulation routes (admin only)
ENABLE_SIM_ROUTES=false

# Notification Service
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
NOTIFICATION_PROVIDER=mock              # mock | twilio

# Twilio SMS Configuration (when NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890          # OR use TWILIO_MESSAGING_SERVICE_SID
# TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# Two-Factor Authentication (2FA)
TWOFA_ENABLED=false
TWOFA_CODE_TTL_SEC=300                  # 5 minutes
TWOFA_MAX_ATTEMPTS=5
TWOFA_RESEND_COOLDOWN_SEC=30
