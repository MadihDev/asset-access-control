generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  username     String           @unique
  firstName    String
  lastName     String
  password     String
  role         UserRole         @default(USER)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lastLoginAt  DateTime?
  createdById  String?
  // Tenant scope (Project + City)
  projectCityId String?
  projectCity    ProjectCity?   @relation(fields: [projectCityId], references: [id])
  // Two-Factor Authentication fields
  phone                 String?           // E.164 format, verified
  twoFactorEnabled      Boolean           @default(false)
  twoFactorVerifiedAt   DateTime?         // Record of phone verification
  accessLogs   AccessLog[]
  auditLogs    AuditLog[]
  rfidKeys     RFIDKey[]
  permissions  UserPermission[]
  createdBy    User?            @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]           @relation("UserCreator")
  refreshTokens RefreshToken[]
  twoFactorChallenges TwoFactorChallenge[]

  @@map("users")
  @@index([projectCityId], map: "idx_users_project_city")
}

model City {
  id        String    @id @default(cuid())
  name      String    @unique
  country   String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addresses Address[]
  projectCities ProjectCity[]

  @@map("cities")
}

model Address {
  id        String   @id @default(cuid())
  street    String
  number    String
  zipCode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  // Tenant scope (Project + City)
  projectCityId String?
  projectCity   ProjectCity? @relation(fields: [projectCityId], references: [id])
  locations Location[]

  @@unique([street, number, zipCode, cityId])
  @@map("addresses")
  @@index([projectCityId], map: "idx_addresses_project_city")
}

model Location {
  id          String    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  addressId   String
  // Tenant scope (Project + City)
  projectCityId String?
  projectCity   ProjectCity? @relation(fields: [projectCityId], references: [id])
  address     Address   @relation(fields: [addressId], references: [id])
  locks       Lock[]

  @@unique([name, addressId], map: "uq_locations_name_address")
  @@map("locations")
  @@index([addressId], map: "idx_locations_address")
  @@index([projectCityId], map: "idx_locations_project_city")
}

model Lock {
  id          String           @id @default(cuid())
  name        String
  description String?
  deviceId    String           @unique
  secretKey   String
  lockType    LockType         @default(DOOR)
  isActive    Boolean          @default(true)
  isOnline    Boolean          @default(false)
  lastSeen    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  locationId  String
  // Tenant scope (Project + City)
  projectCityId String?
  projectCity   ProjectCity?   @relation(fields: [projectCityId], references: [id])
  accessLogs  AccessLog[]
  location    Location         @relation(fields: [locationId], references: [id])
  permissions UserPermission[]

  @@map("locks")
  @@index([locationId], map: "idx_locks_location")
  @@index([isActive, isOnline], map: "idx_locks_active_online")
  @@index([projectCityId], map: "idx_locks_project_city")
}

model RFIDKey {
  id         String      @id @default(cuid())
  cardId     String      @unique
  name       String?
  isActive   Boolean     @default(true)
  issuedAt   DateTime    @default(now())
  expiresAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  userId     String
  // Tenant scope (Project + City)
  projectCityId String?
  projectCity   ProjectCity? @relation(fields: [projectCityId], references: [id])
  accessLogs AccessLog[]
  user       User        @relation(fields: [userId], references: [id])

  @@map("rfid_keys")
  @@index([userId], map: "idx_rfid_keys_user")
  @@index([isActive, expiresAt], map: "idx_rfid_keys_active_exp")
  @@index([projectCityId], map: "idx_rfid_keys_project_city")
}

model UserPermission {
  id        String    @id @default(cuid())
  canAccess Boolean   @default(true)
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  lockId    String
  // Tenant scope (Project + City)
  projectCityId String?
  projectCity   ProjectCity? @relation(fields: [projectCityId], references: [id])
  lock      Lock      @relation(fields: [lockId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, lockId])
  @@map("user_permissions")
  @@index([lockId], map: "idx_user_permissions_lock")
  @@index([userId], map: "idx_user_permissions_user")
  @@index([projectCityId], map: "idx_user_permissions_project_city")
}

model AccessLog {
  id         String       @id @default(cuid())
  accessType AccessType   @default(RFID_CARD)
  result     AccessResult
  timestamp  DateTime     @default(now())
  deviceInfo Json?
  metadata   Json?
  userId     String?
  rfidKeyId  String?
  lockId     String
  // Denormalized cityId for fast filtering/indexing - this will be removed
  cityId     String?
  // Tenant scope (Project + City)
  projectCityId String?
  projectCity   ProjectCity?  @relation(fields: [projectCityId], references: [id])
  lock       Lock         @relation(fields: [lockId], references: [id])
  rfidKey    RFIDKey?     @relation(fields: [rfidKeyId], references: [id])
  user       User?        @relation(fields: [userId], references: [id])

  @@map("access_logs")
  @@index([projectCityId, timestamp], map: "idx_access_logs_project_city_ts")
  @@index([result], map: "idx_access_logs_result")
  @@index([userId], map: "idx_access_logs_user")
  @@index([lockId], map: "idx_access_logs_lock")
}

// New tenant models (Project + City linking)
model Project {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  projectCities ProjectCity[]

  @@map("projects")
}

model ProjectCity {
  id        String   @id @default(cuid())
  projectId String
  cityId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  city    City    @relation(fields: [cityId], references: [id])
  // Back-relations
  users       User[]
  addresses   Address[]
  locations   Location[]
  locks       Lock[]
  permissions UserPermission[]
  accessLogs  AccessLog[]
  rfidKeys    RFIDKey[]

  @@unique([projectId, cityId], map: "uq_project_cities_project_city")
  @@index([projectId], map: "idx_project_cities_project")
  @@index([cityId], map: "idx_project_cities_city")
  @@map("project_cities")
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime    @default(now())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("string")

  @@map("system_config")
}

model NotificationTemplate {
  id        String           @id @default(cuid())
  name      String           @unique
  type      NotificationType
  subject   String?
  body      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("notification_templates")
}

// Two-Factor Authentication challenges (ephemeral)
model TwoFactorChallenge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String   // bcrypt hash of 6-digit code
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  method      String   @default("sms") // "sms" | "totp" (future-proof)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("two_factor_challenges")
  @@index([userId, expiresAt], map: "idx_twofactor_user_expires")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  USER
}

enum LockType {
  DOOR
  GATE
  CABINET
  ROOM
}

enum AccessType {
  RFID_CARD
  MANUAL
  EMERGENCY
  MAINTENANCE
}

enum AccessResult {
  GRANTED
  DENIED_INVALID_CARD
  DENIED_EXPIRED_CARD
  DENIED_NO_PERMISSION
  DENIED_INACTIVE_USER
  DENIED_INACTIVE_LOCK
  DENIED_TIME_RESTRICTION
  ERROR_DEVICE_OFFLINE
  ERROR_SYSTEM_FAILURE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISSION_GRANT
  PERMISSION_REVOKE
  ACCESS_ATTEMPT
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  WEBHOOK
}

// Refresh tokens for rotation and revocation
model RefreshToken {
  id            String   @id @default(cuid())
  jti           String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  isRevoked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  replacedById  String?
  replacedBy    RefreshToken? @relation("RefreshReplacedBy", fields: [replacedById], references: [id])
  // back relation to allow easy traversal (not required by app code)
  replacedTokens RefreshToken[] @relation("RefreshReplacedBy")

  @@index([userId, isRevoked], map: "idx_refresh_tokens_user_revoked")
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@map("refresh_tokens")
}
