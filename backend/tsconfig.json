{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "outDir": "dist",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "prisma", "tests", "test-*.ts"],
  "exclude": ["node_modules", "dist", "test-tree-quick.ts", "test-device-system.ts", "test-twilio-sms.ts"],
  "ts-node": {
    "compilerOptions": {
      "types": ["node", "jest"]
    }
  }
}
